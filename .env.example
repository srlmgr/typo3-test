# Docker images — defaults to Docker Hub; override to use a private registry
# PHP_IMAGE=my-registry/php:8.4-apache
# MARIADB_IMAGE=my-registry/mariadb:11
# COMPOSER_IMAGE=my-registry/composer:2

# Your host user — run 'id -u' and 'id -g' to get the correct values
HOST_UID=1000
HOST_GID=1000

# hint: you may generate a password like this:
# echo $(tr -dc "_A-Za-z0-9#=$()/" < /dev/urandom | head -c24)

# Database
DB_ROOT_PASSWORD=see password hint
DB_NAME=typo3
DB_USER=typo3
DB_PASSWORD=see password hint

# TYPO3 Admin
ADMIN_EMAIL=admin@example.com
ADMIN_USER=admin
ADMIN_PASSWORD=see comment above

# TYPO3 — generate a fresh key per environment: openssl rand -hex 48
TYPO3_ENCRYPTION_KEY=see comment above

# Public base URL of the site (used by config/sites/main/config.yaml)
TYPO3_SITE_URL=http://localhost:8380/

# Ports
TYPO3_PORT=8380

