# Docker images — defaults to Docker Hub; override to use a private registry
# PHP_IMAGE=my-registry/php:8.4-apache
# MARIADB_IMAGE=my-registry/mariadb:11
# COMPOSER_IMAGE=my-registry/composer:2

# Your host user — run 'id -u' and 'id -g' to get the correct values
HOST_UID=1000
HOST_GID=1000

# Database
DB_ROOT_PASSWORD=rootpassword
DB_NAME=typo3
DB_USER=typo3
DB_PASSWORD=typo3pass

# TYPO3 Admin
ADMIN_EMAIL=admin@example.com
ADMIN_USER=admin
ADMIN_PASSWORD=Admin1234!

# TYPO3 — generate a fresh key per environment: openssl rand -hex 48
TYPO3_ENCRYPTION_KEY=see comment above

# Ports
TYPO3_PORT=8380
PMA_PORT=8081
